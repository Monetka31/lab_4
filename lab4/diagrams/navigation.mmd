flowchart TD
    Login(["Авторизация<br/>(вход по email/паролю)"])

    subgraph EMP["Роль: Сотрудник"]
        Dashboard["Главная<br/>карта офиса на дату"]
        List["Список рабочих мест<br/>(фильтры: зона, оборудование)"]
        Detail["Карточка места<br/>+ форма бронирования"]
        My["Мои бронирования"]
        Search["Поиск коллег<br/>на карте офиса"]
    end

    subgraph MGR["Роль: Офис-менеджер"]
        Admin["Админ-панель<br/>брони на дату"]
        AdminPlaces["Управление местами<br/>и зонами"]
    end

    Login -- "роль: сотрудник" --> Dashboard
    Login -- "роль: офис-менеджер" --> Admin

    Dashboard -- "выбор места на карте" --> Detail
    Dashboard -- "«Список»" --> List
    Dashboard -- "«Мои брони»" --> My
    Dashboard -- "«Найти коллегу»" --> Search

    List -- "«Подробнее»" --> Detail
    List -- "«Карта»" --> Dashboard

    Detail -- "успешное бронирование" --> My
    Detail -- "место занято → альтернативы" --> List
    Detail -- "назад" --> Dashboard

    My -- "«Изменить»" --> Detail
    My -- "«Отменить»" --> My
    My -- "назад" --> Dashboard

    Search -- "результат найден" --> Dashboard

    Admin -- "«Места и зоны»" --> AdminPlaces
    Admin -- "принудительная отмена" --> Admin
    AdminPlaces -- "назад" --> Admin
    Admin -- "«Моё место» (как сотрудник)" --> Dashboard

    Dashboard -. "выход" .-> Login
    Admin -. "выход" .-> Login

    classDef entry fill:#f2f2f2,stroke:#333,stroke-width:2px,color:#000;
    class Login entry;
